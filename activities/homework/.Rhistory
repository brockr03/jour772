fentanyl_deaths <- read_csv("drug-deaths-baltimore.csv", col_names = FALSE) |>
clean_names() |>
rename(date = x1, time = x2, case_number = x3, ev_type = x4, loc = x5) |>
mutate(date = mdy(date))
View(fentanyl_deaths)
overdose_calls <- fentanyl_deaths |>
group_by(date) |>
summarize(total_amount = sum(amount)) |>
arrange(desc(total_amount))
