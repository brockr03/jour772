knitr::opts_chunk$set(echo = TRUE)
# turn off sci notation
options(scipen=999)
library(tidyverse)
library(lubridate)
library(janitor)
county_voters_2016 <- read_csv("data/county_voters_2016.csv")
county_voters_2018 <- read_csv("data/county_voters_2018.csv")
